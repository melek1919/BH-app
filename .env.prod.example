# Copier ce fichier vers .env sur le serveur de production, puis renseigner les valeurs réelles.
#   cp .env.prod.example .env
# GÉNÉRER des secrets forts en prod — ne PAS réutiliser les valeurs de dev !

DB_USER=bh_app
# Générer : openssl rand -hex 24  (ou PowerShell : -join ((48..57)+(97..102) | Get-Random -Count 24 | % {[char]$_}))
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=bh_app

# Générer : openssl rand -hex 32  (ou PowerShell : -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_}))
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_64_HEX
JWT_EXPIRES_IN=4h

# Origines autorisées (CORS) : remplacer par le vrai domaine public de l'app
# ex. https://app.bh-assurance.tn,https://bh-assurance.tn
CORS_ORIGINS=https://app.bh-assurance.tn

# URL API embarquée au build du frontend = /api (reverse proxy Nginx). Ne pas changer.
VITE_API_URL=/api